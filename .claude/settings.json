{
  "permissions": {
    "allow": [
      "Bash(./gradlew build*)",
      "Bash(./gradlew test*)",
      "Bash(./gradlew run*)",
      "Bash(./gradlew spotlessApply*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git mv*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(./frc *)",
      "WebFetch(domain:docs.wpilib.org)",
      "WebFetch(domain:github.wpilib.org)",
      "WebFetch(domain:docs.advantagekit.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "deny": [
      "Bash(./gradlew deploy*)",
      "Bash(./gradlew eventDeploy*)",
      "Bash(git push*)",
      "Edit(vendordeps/**)",
      "Edit(.wpilib/**)",
      "Edit(gradle/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/frc",
            "args": [
              "hook",
              "session-start"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/frc",
            "args": [
              "hook",
              "guard-shell"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/frc",
            "args": [
              "hook",
              "guard-edit"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/frc",
            "args": [
              "hook",
              "post-edit"
            ],
            "timeout": 180
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/frc",
            "args": [
              "hook",
              "on-stop"
            ],
            "timeout": 300
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/frc",
            "args": [
              "hook",
              "pre-compact"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
